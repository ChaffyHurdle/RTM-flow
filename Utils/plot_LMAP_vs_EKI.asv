function p = plot_LMAP_vs_EKI(true_RTMflow,my_forward_mesh,my_inverse_mesh,my_darcy,lmap_mean,lmap_var,eki_mean1,eki_var1,eki_mean2,eki_var2,eki_mean3,eki_var3)

t_index = find(true_RTMflow.times > my_darcy.observation_times(5),1,'first');
c_min = min(log(my_darcy.permeability));
c_max = max(log(my_darcy.permeability));

%% Truth
figure(10)
ax(1,1) = subplot(2,5,1);
pdeplot(my_forward_mesh.nodes',my_forward_mesh.elements', ...
    XYData = log(my_darcy.permeability), XYStyle='interp', ...
    ColorMap="turbo",Mesh="off",ColorBar="off")
clim([c_min c_max]);
title('$u^{\dagger}$','interpreter','latex')

%% Sensors
ax(2,1) = subplot(2,5,6);
colormap('gray');
plot(1,1)
hold on
scatter(my_darcy.sensor_locs(:,1),my_darcy.sensor_locs(:,2),'wo','filled')
scatter(my_darcy.sensor_locs(:,1),my_darcy.sensor_locs(:,2),'ko')
hold off
axis on;
title('Sensor locations','interpreter','latex')

%% EKI 1
ax(1,2) = subplot(2,5,2);
pdeplot(my_inverse_mesh.nodes',my_inverse_mesh.elements', ...
            XYData = eki_mean1,XYStyle='interp', ...
            ColorMap="turbo",Mesh="off",ColorBar="off")
hold on
plot_front(true_RTMflow,t_index)
hold off
clim([c_min c_max]);
title(sprintf('$\\bar{u}_{EKI}^{(%d)}$', 500), 'Interpreter', 'latex');

ax(2,2) = subplot(2,5,7);
pdeplot(my_inverse_mesh.nodes',my_inverse_mesh.elements', ...
            XYData = eki_var1,XYStyle='interp', ...
            ColorMap="turbo",Mesh="off",ColorBar="off")
hold on
plot_front(true_RTMflow,t_index)
hold off
clim([0,0.25])
title(sprintf('diag$(\\mathcal{C}_{EKI}^{(%d)})$', 500), 'Interpreter', 'latex');

%% EKI 2
ax(1,3) = subplot(2,5,3);
pdeplot(my_inverse_mesh.nodes',my_inverse_mesh.elements', ...
            XYData = eki_mean2,XYStyle='interp', ...
            ColorMap="turbo",Mesh="off",ColorBar="off")
hold on
plot_front(true_RTMflow,t_index)
hold off
clim([c_min c_max]);
title(sprintf('$\\bar{u}_{EKI}^{(%d)}$', 1000), 'Interpreter', 'latex');


ax(2,3) = subplot(2,5,8);
pdeplot(my_inverse_mesh.nodes',my_inverse_mesh.elements', ...
            XYData = eki_var2,XYStyle='interp', ...
            ColorMap="turbo",Mesh="off",ColorBar="off")
hold on
plot_front(true_RTMflow,t_index)
hold off
clim([0,0.25])
title(sprintf('diag$(\\mathcal{C}_{EKI}^{(%d)})$', 1000), 'Interpreter', 'latex');
%% EKI 3
ax(1,4) = subplot(2,5,4);
pdeplot(my_inverse_mesh.nodes',my_inverse_mesh.elements', ...
            XYData = eki_mean3,XYStyle='interp', ...
            ColorMap="turbo",Mesh="off",ColorBar="off")
hold on
plot_front(true_RTMflow,t_index)
hold off
clim([c_min c_max]);
title(sprintf('$\\bar{u}_{EKI}^{(%d)}$', 5000), 'Interpreter', 'latex');

ax(2,4) = subplot(2,5,9);
pdeplot(my_inverse_mesh.nodes',my_inverse_mesh.elements', ...
            XYData = eki_var3,XYStyle='interp', ...
            ColorMap="turbo",Mesh="off",ColorBar="off")
hold on
plot_front(true_RTMflow,t_index)
hold off
clim([0,0.25])
title(sprintf('diag$(\\mathcal{C}_{EKI}^{(%d)})$', 5000), 'Interpreter', 'latex');
%% LMAP
ax(1,5) = subplot(2,5,5);
pdeplot(my_inverse_mesh.nodes',my_inverse_mesh.elements', ...
            XYData = lmap_mean,XYStyle='interp', ...
            ColorMap="turbo",Mesh="off",ColorBar="off")
hold on
plot_front(true_RTMflow,t_index)
hold off
title(sprintf('$\\bar{u}_{MAP}$'), 'Interpreter', 'latex');
clim([c_min c_max]);

ax(2,5) = subplot(2,5,10);
pdeplot(my_inverse_mesh.nodes',my_inverse_mesh.elements', ...
            XYData = lmap_var,XYStyle='interp', ...
            ColorMap="turbo",Mesh="off",ColorBar="off")
hold on
plot_front(true_RTMflow,t_index)
hold off
clim([0,0.25])
title(sprintf('diag$(\\mathcal{C}_{MAP})$'), 'Interpreter', 'latex');


c1 = colormap(ax(1,1),'turbo');
pos = get(ax(1,5),'Position');
h1 = colorbar('Position', [pos(1)+(1+1/20)*pos(3)  pos(2)  pos(3)/10  pos(4)]);

c2 = colormap(ax(2,5),'turbo');
pos = get(ax(2,5),'Position');
h2 = colorbar('Position', [pos(1)+(1+1/20)*pos(3)  pos(2)  pos(3)/10  pos(4)]);

end