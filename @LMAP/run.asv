function obj = run(obj)

obj.physics_class.permeability = exp(obj.inverse_class.u0)';
obj.pressure_class = Pressure(obj.mesh_class,obj.physics_class);
start_flow_class = obj.RTMflow_class;
obj.RTMflow_class = RTMflow_class;

n = obj.physics_class.nobservations;
umap_seq = zeros(obj.mesh_class.num_elements,n);
Cmap_seq = zeros(obj.mesh_class.num_elements,obj.mesh_class.num_elements,n);
timer_seq = zeros(1,n);

for t = 1:n
    disp(t)
    obj.physics_class.permeability = exp(obj.inverse_class.u0)';
    obj.pressure_class = Pressure(obj.mesh_class,obj.physics_class);
    RTMflow_class = RTMFlow(obj.mesh_class,obj.physics_class,obj.pressure_class);
    RTMflow_class = RTMflow_class.run(inf);
    obj.RTMflow_class = RTMflow_class;
    obj.alpha = 1e4;
    obj.u = obj.inverse_class.u0;

    obj = obj.run_t(t);
    
    umap_seq(:,t) = obj.u_map;
    Cmap_seq(:,:,t) = obj.C_map;
    timer_seq(t) = sum(obj.execution_times);

end
obj.umap_seq = umap_seq;
obj.Cmap_seq = Cmap_seq;
obj.timer_seq = timer_seq;